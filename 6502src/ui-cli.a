;ACME 0.97

; "command line interface"

!if MCA2_USE_CLI {

	NUMBER_OF_DIRECTIONS	= 10
	CL_MAX_WORD_COUNT	= 5	; we only really need four ("use X with Y"),
	; but accepting one more means we can use the same check for
	; "too many words for this command" and "too many words altogether".

!macro ui_main {
		; actual main loop for this UI:
			; get user input
.get			jsr ui_input	; get line from user and pre-process
			; TODO - parse line
			; TODO - call handler or output error message and how to show help
			jmp .get

; stuff called by main loop:
ui_input
		; show prompt
		lda #'>'
		jsr arch_chrout
		; get input
		jsr arch_input	; data is in stringbuf_a, nullterminated, length before terminator is in X
		lda #cr
		jsr arch_chrout
		; postprocess: convert to lower case, substitute umlauts
		;jsr string_a_print
		jsr string_a_tolower	; convert all upper case characters to lower case
		;jsr string_a_print
		jsr string_a_toascii_b	; convert äöüß to aeoeuess
		; split into words
		jsr string_b_towords
		;jsr words_print

		; TODO
		rts

; generate "verb" tables (store min/max args and handler fn, return enum):
	!set UI_verb_counter = 0
	!set UI_minmax = []
	!set UI_handlers = []
	!macro verb ~@enum, @min, @max, @handler {
		@enum = UI_verb_counter
		!set UI_verb_counter = UI_verb_counter + 1
		!if @min > 3 {
			!error "Minimum number of arguments must be in 0..3 range."
		}
		!set UI_minmax = UI_minmax + [ (@max << 2) | @min ]
		!set UI_handlers = UI_handlers + [ @handler ]
	}
	+verb ~VERB_nothing,	0, 0, .cmd_nothing	; dummy command, needed for yz/zy swap
	+verb ~VERB_north,	0, 0, .go_north
	+verb ~VERB_northeast,	0, 0, .go_northeast
	+verb ~VERB_east,	0, 0, .go_east
	+verb ~VERB_southeast,	0, 0, .go_southeast
	+verb ~VERB_south,	0, 0, .go_south
	+verb ~VERB_southwest,	0, 0, .go_southwest
	+verb ~VERB_west,	0, 0, .go_west
	+verb ~VERB_northwest,	0, 0, .go_northwest
	+verb ~VERB_up,		0, 0, .go_up
	+verb ~VERB_down,	0, 0, .go_down
	+verb ~VERB_inventory,	0, 0, .cmd_inventory
	+verb ~VERB_examine,	0, 1, .cmd_examine	; without arg: describe location
	+verb ~VERB_take,	1, 1, .cmd_take
	+verb ~VERB_lose,	1, 1, .cmd_lose
	+verb ~VERB_use,	1, 3, .cmd_use		; "use X" or "use X on Y" etc.
	+verb ~VERB_combine,	2, 3, .cmd_combine	; "combine X Y" or "combine X with Y" etc.
	+verb ~VERB_vocabulary,	0, 0, .cmd_vocabulary
	+verb ~VERB_hint,	0, 0, .cmd_hint
	+verb ~VERB_swapyz,	0, 0, .cmd_swapyz	; "zy" swaps y and z, "yz" does nothing

ui_minmax	!for @mm in UI_minmax {
			!by @mm
		}
ui_handler_lo	!for @h in UI_handlers {
			!by <@h
		}
ui_handler_hi	!for @h in UI_handlers {
			!by >@h
		}

; generate list of actual words and table with their enum values:
	!set UI_words = ""
	!set UI_enums = []
	!macro cmd @word, @enum {
		!set UI_words = UI_words + @word + "\0"
		!set UI_enums = UI_enums + [ @enum ]
	}

; CAUTION: it should be possible to use shortcuts for long commands. the easiest
; way to do this is to scan all possible commands and select the first where the
; user input matches, i.e. we want the inputs "n", "no" and "north" all to
; select the command "north", but we do not want "n" to match "northeast".
; therefore, "north" must be earlier in the list than "northeast". but this is
; language-dependent, so we cannot just translate each string on its own, but
; the whole table must be sorted for each language separately:
	!if DEUTSCH {
.verb_table
		+cmd "?",		VERB_vocabulary	; vocabulary, info, ?
		+cmd "ab",		VERB_down	; unten, ab, runter
		+cmd "benutze",		VERB_use
		+cmd "hoch",		VERB_up		; oben, hoch, rauf
		 +cmd "hilfe",		VERB_hint
		+cmd "info",		VERB_vocabulary	; vocabulary, info, ?
		+cmd "inventar",	VERB_inventory
		+cmd "kombiniere",	VERB_combine
		; ...we need "n" before "no", "no" before "norden" and "norden" before "nordosten"
		+cmd "n",		VERB_north	; n, nor...
		 +cmd "no",		VERB_northeast	; no, nordo...
		  +cmd "norden",	VERB_north	; n, nor...
		   +cmd "nordosten",	VERB_northeast	; no, nordo...
		   +cmd "nordwesten",	VERB_northwest	; nw, nordw...
		+cmd "nimm",		VERB_take
		+cmd "nw",		VERB_northwest	; nw, nordw...
		+cmd "osten",		VERB_east	; o...
		 +cmd "oben",		VERB_up		; oben, hoch, rauf
		+cmd "rauf",		VERB_up		; oben, hoch, rauf
		+cmd "runter",		VERB_down	; unten, ab, runter
		+cmd "s",		VERB_south	; s...
		+cmd "schaue",		VERB_examine	; untersuche, schau
		+cmd "so",		VERB_southeast	; so, suedo...
		+cmd "sueden",		VERB_south	; s...
		+cmd "suedosten",	VERB_southeast	; so, suedo...
		+cmd "suedwesten",	VERB_southwest	; sw, suedw...
		+cmd "sw",		VERB_southwest	; sw, suedw...
		+cmd "unten",		VERB_down	; unten, ab, runter
		+cmd "untersuche",	VERB_examine	; untersuche, schau
		+cmd "verliere",	VERB_lose
		+cmd "vocabulary",	VERB_vocabulary	; vocabulary, info, ?
		+cmd "westen",		VERB_west	; w...
		; FIXME - add "y" and "z" entries so they do not do the same as "yz"/"zy"?
		+cmd "yz",		VERB_nothing	; yz
		+cmd "zy",		VERB_swapyz	; zy
		;"ic" -> infocom
		;"ms" -> magnetic scrolls
		; add "load" and "save"
	} else {
.verb_table
		+cmd "?",		VERB_vocabulary	; vocabulary, info, ?
		+cmd "apply",		VERB_use	; apply, use
		+cmd "combine",		VERB_combine
		+cmd "down",		VERB_down
		+cmd "east",		VERB_east
		 +cmd "examine",	VERB_examine
		+cmd "help",		VERB_hint
		+cmd "info",		VERB_vocabulary	; vocabulary, info, ?
		+cmd "inventory",	VERB_inventory
		+cmd "lose",		VERB_lose
		+cmd "north",		VERB_north
		+cmd "northeast",	VERB_northeast
		+cmd "northwest",	VERB_northwest
		 +cmd "ne", 		VERB_northeast
		 +cmd "nw",		VERB_northwest
		+cmd "south",		VERB_south
		+cmd "southeast",	VERB_southeast
		+cmd "southwest",	VERB_southwest
		 +cmd "se",		VERB_southeast
		 +cmd "sw",		VERB_southwest
		+cmd "take",		VERB_take
		+cmd "use",		VERB_use	; apply, use
		 +cmd "up",		VERB_up
		+cmd "vocabulary",	VERB_vocabulary	; vocabulary, info, ?
		+cmd "west",		VERB_west
		; FIXME - add "y" and "z" entries so they do not do the same as "yz"/"zy"?
		+cmd "yz",		VERB_nothing	; yz
		+cmd "zy",		VERB_swapyz	; zy
		;"ic" -> infocom
		;"ms" -> magnetic scrolls
		; add "load" and "save"
	}
	; "untersuche", "schau" / "examine"	ohne Argument -> Raumbeschreibung, also screen redraw!

ui_word_list	!tx UI_words, 0
		.size = * - ui_word_list
		!if .size > 255 {
			!error "word list takes " + dec(.size) + " bytes, adjust code to handle more than a page!"
		} else {
			; at time of writing:
			; deutsch takes 201 bytes
			; english takes 152 bytes
			;!info "word list takes " + dec(.size) + " bytes."
		}
ui_enums	!for @e in UI_enums {
			!by @e
		}

; command handler functions:
.go_north
.go_northeast
.go_east
.go_southeast
.go_south
.go_southwest
.go_west
.go_northwest
.go_down
.go_up
		; TODO!
		rts
.cmd_hint
.cmd_vocabulary
.cmd_inventory
.cmd_examine
.cmd_take
.cmd_lose
.cmd_use
.cmd_combine
		; TODO!
		rts
.cmd_nothing ; "yz" -> do nothing
.cmd_swapyz ; "zy" -> toggle flag to exchange y and z on input
		; TODO!
		rts

	; add architecture-dependent code for command line:
		+arch_input

; helper functions for string handling:

!if 0 {
string_a_print ; print string buffer A (mostly for debugging purposes)
		ldx #0
		beq ++
		;;;
--			jsr arch_chrout
			inx
++			lda stringbuf_a, x
			bne --
		; append newline
		lda #cr
		jmp arch_chrout

; print word from string buffer B starting at offset X (mostly for debugging purposes)
--			jsr arch_chrout
			inx
word_X_print
++			lda stringbuf_b, x
			bne --
		rts
words_print ; print all words (mostly for debugging purposes)
		ldy #0
		beq @entry
		;;;
--			ldx word_indices, y
			jsr word_X_print
			; append newline
			lda #cr
			jsr arch_chrout
			; next
			iny
@entry			cpy word_count
			bcc --
		rts
}

string_a_tolower ; process string buffer A: convert all upper case characters to lower case
		ldx #0
		beq ++
		;;;
--			; A..Z -> a..z
			cmp #'A'
			bcc @next
			cmp #'Z' + 1
			bcc @convert
			; À..Þ -> à..þ
			cmp #$c0
			bcc @next
			cmp #$de + 1
			bcs @next
@convert		ora #$20
			sta stringbuf_a, x
@next			inx
++			lda stringbuf_a, x
			bne --
		rts

string_a_toascii_b ; convert ä/ö/ü/ß to ae/oe/ue/ss (buffer A to B)
		ldx #0
		ldy #0
		beq @entry
		;;;
--			cmp #ß
			bne ++
				lda #'s'
				sta stringbuf_b, y	; overwrite ß
				bne @append
				;;;
++			cmp #ä
			bne ++
				lda #'a'
				bne @overwrite_and_append_e
				;;;
++			cmp #ö
			bne ++
				lda #'o'
				bne @overwrite_and_append_e
				;;;
++			cmp #ü
			bne @next
				lda #'u'
@overwrite_and_append_e		sta stringbuf_b, y	; overwrite ä/ö/ü with a/o/u
				lda #'e'
@append				iny
				sta stringbuf_b, y	; append second character
@next			inx
			iny
@entry			lda stringbuf_a, x
			sta stringbuf_b, y	; first make a copy (äöüß will be overwritten later)
			bne --
		rts
!if 0 {
;string_b_to_a ; copy string from temp buffer B back to main buffer A
		ldx #$ff	; pre-init
--			inx
			lda stringbuf_b, x
			sta stringbuf_a, x
			bne --
		rts
}

string_b_towords ; split string in buffer B into separate words
; output:
;word_count	byte holding number of words found (in 0..CL_MAX_WORD_COUNT range)
;word_indices	array of start indices
;stringbuf_b	array of actual data
; example: "  word1  word2  word3  " should return (3, [2, 9, 16, ...])
	; init:
		ldx #0
		stx word_count
	; find next word start:
		dex;ldx #-1
@wordloop
--			inx
			lda stringbuf_b, x
			beq @done
			cmp #' '
			beq --
		; we found a non-space at x, so this starts a new word:
		txa	; remember start index
		ldx word_count
		cpx #CL_MAX_WORD_COUNT
		bcs @too_many_words	; new word would exceed maximum
		sta word_indices, x	; remember where the new word starts
		inc word_count	; count this word
		tax	; restore index
		; scan forward until space or terminator:
--			inx
			lda stringbuf_b, x
			beq @done
			cmp #' '
			bne --
		; we found a space, so replace with terminator
		lda #0
		sta stringbuf_b, x
		jmp @wordloop	; look for non-space
@too_many_words
@done
		rts

	}//endmacro

}//endif
