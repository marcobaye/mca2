charset
	+charset_umlauts
	+charset_special
	+charset_uppercase
	+charset_lowercase

charset_map_char ; map ISO-8859/1 character in A to a symbol we can actually print:
		tax
		lda #$7f	; we do not support any chars in the 0xa0..0xbf range
		cpx #$c0
		bcc +
			lda @iso_to_local - $c0, x
+		rts
@iso_to_local:
        !h 7f7f7f7f057f7f067f7f7f7f7f7f7f7f7f7f7f7f7f7f177f7f7f7f7f1d7f7f1e
        !h 00010203047f7f0708090a0b0c0d0e0f7f1112131415167f18191a1b1c7f7f1f
}
