;ACME 0.97

	petscii_F1	= 133:	petscii_F2	= 137
	petscii_F3	= 134:	petscii_F4	= 138
	petscii_F5	= 135:	petscii_F6	= 139
	petscii_F7	= 136:	petscii_F8	= 140

; helper values
	CR		= arch_NEWLINE
	cr		= arch_NEWLINE
; FIXME - make cbm architectures use a different code for CLEAR
	colorbase	= $80	; 0x80..0x8f
; the color codes are not actually UTF-8-encoded, but our "decoder" does not
; care and will accept them anyway.

; code points 0xa0..0xff are mostly printables, with the exception of 0xad,
; which is a soft hyphen. 0xa0 is non-breaking space.
; " ¡¢£¤¥¦§¨©ª«¬ ®¯°±²³´µ¶·¸¹º»¼½¾¿"	0xa0..0xbf, UTF-8 encodes as 0xc2 0xa0 .. 0xc2 0xbf
; "ÀÁÂÃÄÅÆÇÈÉÊËÌÍÎÏÐÑÒÓÔÕÖ×ØÙÚÛÜÝÞß"	0xc0..0xdf, UTF-8 encodes as 0xc3 0x80 .. 0xc3 0x9f
; "àáâãäåæçèéêëìíîïðñòóôõö÷øùúûüýþÿ"	0xe0..0xff, UTF-8 encodes as 0xc3 0xa0 .. 0xc3 0xbf

;-------------------------------------------------------------------------------
; convert UTF-8 to ISO-8859/1
; this "decoder" does not attempt to recognize encoding violations. it only does
; what is needed to convert utf-8-encoded text to iso-8859/1.
; unsupported code points (everything higher than 0xff) are converted to 0x7f.
utf8_to_iso ; must keep X/Y!
		; 0x80..0xbf are continuation bytes,
		; 0xc0..0xff either start sequences or are forbidden:
		;  0xc0 is forbidden because its sequences would decode to ascii (0x00..0x3f)
		;  0xc1 is forbidden because its sequences would decode to ascii (0x40..0x7f)
		;  0xc2 "converts" the next byte from 0x80..0xbf to 0x80..0xbf
		;  0xc3 converts the next byte from 0x80..0xbf to 0xc0..0xff
		cmp #$c2
		beq @done	; 0xc2 -> Z set -> caller ignores this byte
		bcs @c3_or_higher
; handle continuation bytes 0x80..0xbf:
; color codes (0x80..0x8f) and CLEAR arrive here without a proper UTF-8 sequence
; start, so they must pass through unchanged.
; continuation bytes following a 0xc2 should be "converted" to the value they
; already have, so they must pass through unchanged.
; continuation bytes following a 0xc3 should be converted by ORing 0x40.
; continuation bytes following 0xc4 or higher must be ignored:
			pha	; buffer A so we can check counter without clobbering X/Y
			lda #0	: @ignore_count = * - 1
			bne @ignore_one_more_byte
			pla
; we do the conversion using an OR mask that is shifted left before each use:
; the value 0x20 is used for 0xc3 (shifted to 0x40 -> OR -> done)
; the values 0x40, 0x80 and 0x00 are used otherwise (shifted to 0x80, 0x00, 0x00 -> no change)
; we do the shift before the OR because that means we have a correct Z flag at the end:
			asl @or_mask	; update mask value
			ora #$00	: @or_mask = * - 1	; convert or do nothing
			rts	; Z clear -> ok, use A

@ignore_one_more_byte	pla	; fix stack
			dec @ignore_count
@return_with_Z		lda #0	; set Z
			rts	; Z set -> caller ignores this byte

@c3_or_higher	cmp #$c3	; prefix byte to convert 0x80..0xbf to 0xc0..0xff
		bne @too_high
; 0xc3 means to convert 0x80..0xbf to 0xc0..0xff.
; prepare value to fix the next byte (0x20, will be shifted to 0x40 before ORing):
			lda #$20
			sta @or_mask
			lda #0	; set Z
@done			rts	; Z tells caller whether to ignore byte

@too_high
; the number of set MSBs is the total byte count of the sequence.
; decrease by one, write to @ignore_count and return 0x7f ("unsupported") with Z clear
		pha	; buffer A so we can init counter without clobbering X/Y
		lda #-2	; pre-init matching loop below
		sta @ignore_count
		pla
--			inc @ignore_count
			asl
			bcs --
		lda #$7f	; this also clears Z
		rts	; Z clear -> caller uses this byte
;-------------------------------------------------------------------------------

; print immediate
my_primm	pla	; get low byte of return address - 1
		tay	; into Y
		pla	; get high byte of return address - 1
		sta .primm_ptr + 1	; to ptr high
		jmp +
---			jsr my_chrout
+			iny
			bne +
				inc .primm_ptr + 1	; fix high byte
+			lda MODIFIED16 & $ff00, y	: .primm_ptr = * - 2	; low byte stays zero!
			bne ---
		; push updated address onto stack
		lda .primm_ptr + 1
		pha
		tya
		pha
		rts	; return to caller (after zero-terminated text)


print_AAYY ; print zero-terminated string. keeps X.
		sta .print_ptr + 1
		jmp +
---			jsr my_chrout
			iny
			bne +
				inc .print_ptr + 1	; fix high byte
+			lda MODIFIED16 & $ff00, y	: .print_ptr = * - 2	; low byte stays zero!
			bne ---
		rts

; wrapper for CHROUT (to handle UTF8 and color codes etc)
my_chrout ; must keep X/Y!
		; 00..7f are handled right away
		cmp #$80
		bcc wordwrapped
		; bytes with msb set must be fed to utf-8 decoder:
		jsr utf8_to_iso	; -> Z set means ignore character
		beq .rts
		cmp #$7f	; "unsupported"?
		beq wordwrapped
		; 90..9f are passed on to get CLEAR to work
		; a0..ff are printables again
		cmp #$90
		bcs wordwrapped
		; now only color codes (0x80..0x8f) are left:
		pha
		lda #0	; output dummy code to flush buffer
		jsr wordwrapped
		pla
		+arch_set_text_color_A	; FIXME - change macro to fn!
.rts		rts

; word wrap:
.xbuf		!by 0
.space_left	!by arch_LINE_LENGTH
.chars_in_buf	!by 0
.indents	!by 0
indent0		lda #0
		+bit16
indent1		lda #1
		sta .indents
		rts
wordwrapped ; output character with automatic word wrap. KEEPS X/Y!
		cmp #$21	; low control codes and space flush buffer
		bcc .control_or_space
		cmp #$80	; printables with msb clear?
		bcc wordwrap_printable
		cmp #$a0	; high control codes flush buffer (shift space could be used as nbsp)
		bcc .control_hi
		; printables with msb set
wordwrap_printable ; append to buffer
		stx .xbuf
		ldx .chars_in_buf
		sta linebuf, x
		cpx #arch_LINE_LENGTH	; buffer overrun? (old value!)
		bne .end_append
			; buffer overran, so fuck the word wrap, just output it
			; "chars_left" does not change in this case!
			jsr linebuf_flush
			; and move the new character to start of buf
			lda linebuf + arch_LINE_LENGTH
			sta linebuf
.end_append	inc .chars_in_buf
		ldx .xbuf
		rts

.control_or_space
		cmp #' '
		beq .space
		cmp #cr
		beq .cr
		cmp #petscii_HOME
		beq .home
.control_hi ; A is separator code, so flush contents of buffer, then output A
		cmp #petscii_CLEAR
		beq .clear
.control	pha
		stx .xbuf

		; does buffer fit in current line?
		lda .space_left
		cmp .chars_in_buf
		bcs +
			; too little space on line, so do wrap
			; first force carriage return
			lda #cr
			jsr arch_chrout
			jsr .new_line

			lda .space_left
			cmp .chars_in_buf
+		bne .small
			; fits exactly
			jsr linebuf_flush
			jsr .new_line

			ldx .xbuf
			pla
			jsr arch_chrout
			sec	; next space could be skipped
			rts

.small		lda .space_left
		sec
		sbc .chars_in_buf
		sta .space_left
		jsr linebuf_flush

		ldx .xbuf
		pla
		jsr arch_chrout
		clc	; ok
		rts

.new_line	lda #arch_LINE_LENGTH	; next line is completely unused
		sta .space_left
		ldx .indents
		beq +
			lda #' '
			jsr arch_chrout
			dec .space_left
+		rts

.space ; code is space
		lda #0	; output dummy code instead
		jsr .control
		bcs +
			; space must be output
			lda #' '
			jsr arch_chrout
			dec .space_left
			bne +
				jsr .new_line
+		rts

.home
.clear
.cr		jsr .control
		lda #arch_LINE_LENGTH
		sta .space_left
		rts

linebuf_flush ; output what's in the line buffer
		ldx #0
		beq +
		;--
---			lda linebuf, x
			jsr arch_chrout
			inx
+			cpx .chars_in_buf
			bne ---
		ldx #0
		stx .chars_in_buf
		rts
