;ACME 0.97

; add architecture-specific stuff (helper functions, tables etc.)
	+arch_bulk

; -- end of program binary --

; maybe call an arch_* macro here so program counter can be changed for
; external storage to be put elsewhere?

; -- start of external storage --

softstack_lo
	* = * + MAX_RECURSIONS
softstack_hi
	* = * + MAX_RECURSIONS
directions_lo
	* = * + NUMBER_OF_DIRECTIONS	; n/s/w/e/u/d	TODO: add ne/se/sw/nw
directions_hi
	* = * + NUMBER_OF_DIRECTIONS	; n/s/w/e/u/d	TODO: add ne/se/sw/nw
gamevars_lo
	* = * + gamevars_COUNT
gamevars_hi
	* = * + gamevars_COUNT
itemlist_buf
	* = * + gamevars_ITEMCOUNT
linebuf ; line buffer for word wrap (can hold one byte more than actual line)
	* = * + arch_LINE_LENGTH + 1
!if MCA2_USE_CLI {
stringbuf_a ; main buffer for string editing
	* = * + 256
stringbuf_b ; temporary buffer for string editing
	* = * + 256
}

; -- end of external storage --

; check architecture-specific memory limit
	+arch_check_memlimit
